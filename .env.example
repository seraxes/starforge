# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://starforge:starforge@127.0.0.1:5432/starforge

# Payload CMS secret — change this to a long random string before any shared use
PAYLOAD_SECRET=dev-only-change-me-to-a-long-random-string

# Starforge core auth (Better Auth) — the only sign-in (also unlocks /admin when cms_access)
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: comma-separated emails promoted to core app role `admin`
# (+ cms_access) on signup, seed, and the next signed-in request after restart.
# STARFORGE_ADMIN_EMAILS=you@example.com

# Published content cache backend (default = Next.js tags; local-friendly).
# Redis is planned for DigitalOcean production — leave unset locally.
# STARFORGE_CONTENT_CACHE=redis
