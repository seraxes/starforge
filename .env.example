# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://starforge:starforge@127.0.0.1:5432/starforge

# Payload CMS secret — change this to a long random string before any shared use
PAYLOAD_SECRET=dev-only-change-me-to-a-long-random-string

# Starforge core auth (Better Auth) — the only sign-in (also unlocks /admin when cms_access).
# Same secret signs the Site Chrome → Environment gate cookie after password unlock.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secure cookies + HSTS (SF-129). Unset = auto from https:// app URL, else NODE_ENV=production.
# Leave unset for local http://localhost. On production HTTPS set BETTER_AUTH_URL=https://… (auto).
# STARFORGE_SECURE_COOKIES=1
# STARFORGE_SECURE_COOKIES=0

# Extra browser origins that may use the Payload admin cookie (Payload `csrf`),
# comma-separated. App URL origins (+ localhost/127.0.0.1 twin) are always trusted.
# STARFORGE_TRUSTED_ORIGINS=https://www.example.com

# Content-Security-Policy (SF-140). Sources are composed from enabled features
# (Turnstile, Font Awesome, analytics atom, Page Settings CSS/JS origins).
# report-only (default) = enforce only object-src/base-uri/form-action/frame-ancestors,
# send the full policy as Content-Security-Policy-Report-Only (check the browser console).
# enforce = full policy blocks. off = floor only, no report-only header.
# STARFORGE_CSP_MODE=report-only
# STARFORGE_CSP_MODE=enforce
# Optional report-uri for violation reports (path or URL).
# STARFORGE_CSP_REPORT_URI=

# Optional: comma-separated emails promoted to core app role `admin`
# (+ cms_access) on signup, seed, and the next signed-in request after restart.
# STARFORGE_ADMIN_EMAILS=you@example.com

# Optional: emails allowed to edit script-capable Page Settings fields
# (custom head, body hooks, JS lists, atom scripts, FA HTML overrides).
# When unset/empty, all app admins are developer-admins (local default).
# STARFORGE_DEVELOPER_ADMIN_EMAILS=you@example.com

# Module install allowlist override (optional). When set, replaces starforge.modules.json
# for `npm run modules:generate` / predev / prebuild. Comma-separated catalog ids.
# SF_MODULES=platform:better-auth,platform:payload-cms,product:layout-manager,page-content,site-header,logo,menu,copyright,social,custom

# Published content cache backend (default = Next.js tags; local-friendly).
# For DigitalOcean multi-instance: set redis + REDIS_URL. Leave unset locally.
# STARFORGE_CONTENT_CACHE=redis
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=rediss://default:PASSWORD@your-do-redis-host:25061

# Media object storage (default = local disk via Payload staticDir /media).
# For DigitalOcean Spaces (or any S3-compatible store): set s3 + S3_* below.
# Leave unset locally. Secrets stay in env — never Site Settings / DB.
# STARFORGE_MEDIA_STORAGE=local
# STARFORGE_MEDIA_STORAGE=s3
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_BUCKET=your-space-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional CDN / virtual-host public base (no trailing slash):
# S3_PUBLIC_BASE_URL=https://your-space-name.nyc3.cdn.digitaloceanspaces.com
# S3_FORCE_PATH_STYLE=false
# Prefer private when Form respondent uploads share this bucket (Core admin
# serves them via /api/admin/form-attachments/[id]). public-read keeps CDN
# library URLs simple but object URLs are reachable if guessed.
# S3_ACL=private
# S3_ACL=public-read

# Cloudflare Turnstile (Core Form captcha) — site key is public; secret stays server-only.
# Enable + choose provider under Site Chrome; Forms opt into the site default.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Outbound email (Mailer port) — enable + provider + From under Site Chrome.
# Secrets stay here only. Local default provider is console (logs, no network).
# STARFORGE_MAIL_FROM=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# RESEND_API_KEY=

# Core admin → Site Chrome → Environment (gated) writes gitignored `.env.local`.
# Production is read-only unless write is forced. Prefer files/ops over a writable UI.
# STARFORGE_ENV_EDITOR=write
# STARFORGE_ENV_EDITOR=off

# Admin theme port (Core `/app/admin` + Payload `/admin`). Default: starforge-gantry.
# CSS switches by changing the live imports in frontend layout + (payload)/custom.css.
# STARFORGE_ADMIN_THEME=starforge-gantry
