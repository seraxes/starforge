# Copy to .env and adjust. Root .env is loaded by the API.

# --- PostgreSQL ---
DATABASE_URL=postgresql://starforge:starforge@localhost:5432/starforge

# --- API ---
API_HOST=0.0.0.0
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT (access short-lived; refresh longer — rotate in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Email (provider-agnostic; "console" logs messages in dev) ---
EMAIL_TRANSPORT=console
EMAIL_FROM="Starforge <noreply@localhost>"
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3001
