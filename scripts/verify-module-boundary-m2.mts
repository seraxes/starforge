/**
 * Smoke: M2 leftovers — admin.routes codegen shims + sf_module_settings host.
 * Run: npm run verify:module-boundary-m2
 */
import assert from 'node:assert/strict'
import { existsSync, readFileSync } from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')

function read(rel: string): string {
  return readFileSync(path.join(ROOT, rel), 'utf8')
}

function mustExist(rel: string) {
  assert.ok(existsSync(path.join(ROOT, rel)), `missing ${rel}`)
}

// Contract types
const defineModule = read('src/core/modules/define-module.ts')
assert.match(defineModule, /StarforgeModuleAdminRoute/)
assert.match(defineModule, /StarforgeModuleSettingsDecl/)
assert.match(defineModule, /routes\?:/)
assert.match(defineModule, /settings\?:/)

// Generic settings table + store + panel host
mustExist('src/core/db/migrations/0001_sf_module_settings.sql')
assert.match(read('src/core/db/schema.ts'), /sfModuleSettings|sf_module_settings/)
assert.match(read('src/core/db/migrations/meta/_journal.json'), /0001_sf_module_settings/)
mustExist('src/core/modules/module-settings-store.ts')
mustExist('src/core/modules/module-settings-document.ts')
mustExist('src/core/modules/ModuleSettingsPanelHost.tsx')

const host = read('src/core/modules/ModuleSettingsPanelHost.tsx')
assert.match(host, /moduleSettingsPanelLoaders/)
assert.doesNotMatch(host, /from ['"]@\/modules\//)

// Media declares admin.routes (reference pack)
const mediaManifest = read('src/modules/media/manifest.ts')
assert.match(mediaManifest, /routes:\s*\[/)
assert.match(mediaManifest, /path: 'media'/)
assert.match(mediaManifest, /path: 'media\/settings'/)
assert.match(mediaManifest, /MediaLibraryPage/)
assert.match(mediaManifest, /MediaSettingsPage/)

// Generated registry loaders
const registry = read('src/generated/module-registry.ts')
assert.match(registry, /adminRouteLoaders/)
assert.match(registry, /moduleSettingsPanelLoaders/)
assert.match(registry, /path: "media"/)
assert.match(registry, /path: "media\/settings"/)
assert.match(registry, /MediaLibraryPage/)
assert.match(registry, /MediaSettingsPage/)

// Generated App Router shims (no hand Core media pages)
mustExist('src/app/(frontend)/app/admin/(modules)/media/page.tsx')
mustExist('src/app/(frontend)/app/admin/(modules)/media/settings/page.tsx')
assert.equal(
  existsSync(path.join(ROOT, 'src/app/(frontend)/app/admin/media/page.tsx')),
  false,
  'hand-written admin/media/page.tsx should be removed',
)
assert.equal(
  existsSync(path.join(ROOT, 'src/app/(frontend)/app/admin/media/settings/page.tsx')),
  false,
  'hand-written admin/media/settings/page.tsx should be removed',
)

const libraryShim = read('src/app/(frontend)/app/admin/(modules)/media/page.tsx')
assert.match(libraryShim, /AUTO-GENERATED by `npm run modules:generate`/)
assert.match(libraryShim, /@\/modules\/media\/admin\/MediaLibraryPage/)

const settingsShim = read('src/app/(frontend)/app/admin/(modules)/media/settings/page.tsx')
assert.match(settingsShim, /AUTO-GENERATED by `npm run modules:generate`/)
assert.match(settingsShim, /@\/modules\/media\/admin\/MediaSettingsPage/)

// Codegen knows how to emit routes + panels
const gen = read('scripts/generate-module-registry.mts')
assert.match(gen, /writeAdminRouteShims/)
assert.match(gen, /adminRouteLoaders/)
assert.match(gen, /moduleSettingsPanelLoaders/)

console.log('verify-module-boundary-m2: pass')
