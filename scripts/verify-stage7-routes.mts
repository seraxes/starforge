/**
 * Stage 7 — an allowlist that omits product:events (and particles that require
 * it) must not write events route shims and must leave no static
 * `@/modules/events` import under `src/app` or `src/instrumentation.ts`.
 *
 * The fixture is computed here. It is not the committed flavor in
 * `starforge.modules.json`. The script restores the core flavor before exit.
 *
 * Run: npm run verify:stage7-routes
 */
import assert from 'node:assert/strict'
import { spawnSync } from 'node:child_process'
import { existsSync, readdirSync, readFileSync, statSync } from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

import { ALL_MODULE_MANIFESTS } from '../src/modules/manifest-index.ts'
import { closeModuleRequires } from '../src/core/modules/requires-graph.ts'

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const EVENTS = 'product:events'

function readPreset(): string[] {
  const file = JSON.parse(readFileSync(path.join(ROOT, 'starforge.modules.json'), 'utf8')) as {
    flavor?: string
    presets?: Record<string, unknown>
  }
  const flavor = file.flavor?.trim() || 'core'
  const preset = file.presets?.[flavor]
  assert.ok(Array.isArray(preset), `presets.${flavor} must be an array`)
  return preset.filter((id): id is string => typeof id === 'string')
}

function pullsEvents(id: string, edges: Map<string, readonly string[]>, seen = new Set<string>()): boolean {
  if (id === EVENTS) return true
  if (seen.has(id)) return false
  seen.add(id)
  for (const dep of edges.get(id) ?? []) {
    if (pullsEvents(dep, edges, seen)) return true
  }
  return false
}

function omitEventsFixture(preset: string[]): string[] {
  const edges = new Map(ALL_MODULE_MANIFESTS.map((entry) => [entry.id, entry.requires ?? []]))
  return preset.filter((id) => id !== EVENTS && !pullsEvents(id, edges))
}

function generate(env: NodeJS.ProcessEnv): void {
  const result = spawnSync('npx', ['tsx', 'scripts/generate-module-registry.mts'], {
    cwd: ROOT,
    env,
    stdio: 'inherit',
    shell: true,
  })
  if (result.status !== 0) {
    throw new Error(`modules:generate exited ${result.status}`)
  }
}

function walkSources(dir: string, hits: string[]): void {
  if (!existsSync(dir)) return
  for (const name of readdirSync(dir)) {
    const full = path.join(dir, name)
    if (statSync(full).isDirectory()) {
      walkSources(full, hits)
      continue
    }
    if (!/\.(ts|tsx)$/.test(name)) continue
    const text = readFileSync(full, 'utf8')
    if (!text.includes('@/modules/events') && !text.includes("@/modules/events")) continue
    const banner = text.includes('AUTO-GENERATED by `npm run modules:generate`')
    if (!banner) hits.push(path.relative(ROOT, full).replaceAll('\\', '/'))
  }
}

const preset = readPreset()
const requested = omitEventsFixture(preset)
const closed = closeModuleRequires(requested, ALL_MODULE_MANIFESTS)
assert.equal(closed.ids.includes(EVENTS), false, 'omit fixture must not pull product:events')

const eventsShim = path.join(
  ROOT,
  'src/app/(frontend)/(public)/[locale]/(modules)/events/page.tsx',
)
const eventsAdminShim = path.join(ROOT, 'src/app/(frontend)/admin/(modules)/events/page.tsx')
const eventsApiShim = path.join(ROOT, 'src/app/api/(modules)/events/[eventId]/ics/route.ts')

const restoreEnv = { ...process.env }
delete restoreEnv.SF_MODULES

let failed = false
try {
  generate({ ...process.env, SF_MODULES: requested.join(',') })
  assert.equal(existsSync(eventsShim), false, 'events public shim must not be written')
  assert.equal(existsSync(eventsAdminShim), false, 'events admin shim must not be written')
  assert.equal(existsSync(eventsApiShim), false, 'events api shim must not be written')

  const hits: string[] = []
  walkSources(path.join(ROOT, 'src/app'), hits)
  const instrumentation = readFileSync(path.join(ROOT, 'src/instrumentation.ts'), 'utf8')
  assert.equal(instrumentation.includes('@/modules/events'), false)
  assert.deepEqual(hits, [], `static events imports outside generated shims:\n${hits.join('\n')}`)
  console.log(
    `verify-stage7-routes: omit fixture (${requested.length} ids) wrote no events shims`,
  )
} catch (error) {
  failed = true
  console.error(error instanceof Error ? error.message : error)
} finally {
  generate(restoreEnv)
}

if (failed) process.exit(1)
console.log('verify-stage7-routes: core flavor restored')
