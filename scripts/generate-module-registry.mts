/**
 * Write thin App Router re-export shims for each admin.routes path.
 * Lives under `admin/(modules)/…` so Core hand pages are not required for new packs.
 */
async function writeAdminRouteShims(
  routes: Array<{
    moduleId: string
    path: string
    pageImportPath: string
    pageExportName: string
  }>,
): Promise<void> {
  await mkdir(ADMIN_MODULES_DIR, { recursive: true })

  // Remove previously generated shim page.tsx files (marker comment).
  async function walkAndClean(dir: string): Promise<void> {
    let entries: string[]
    try {
      entries = await readdir(dir)
    } catch {
      return
    }
    for (const name of entries) {
      const full = path.join(dir, name)
      const st = await stat(full)
      if (st.isDirectory()) {
        await walkAndClean(full)
        continue
      }
      if (name !== 'page.tsx') continue
      const src = await readFile(full, 'utf8')
      if (src.includes(ADMIN_SHIM_MARKER)) {
        await rm(full)
      }
    }
  }
  await walkAndClean(ADMIN_MODULES_DIR)

  const readme = `# Generated admin module route shims

${ADMIN_SHIM_MARKER} — do not edit page.tsx files here by hand.

Declare \`admin.routes\` on the module manifest; \`npm run modules:generate\`
writes thin re-exports. Route group \`(modules)\` does not affect the URL
(\`media\` → \`/admin/media\`).
`
  await writeFile(path.join(ADMIN_MODULES_DIR, 'README.md'), readme, 'utf8')

  for (const route of routes) {
    const segments = route.path.split('/').filter(Boolean)
    if (!segments.length) continue
    const pageDir = path.join(ADMIN_MODULES_DIR, ...segments)
    await mkdir(pageDir, { recursive: true })
    const exportLine =
      route.pageExportName === 'default'
        ? `export { default, metadata } from ${jsonString(route.pageImportPath)}`
        : `export { ${route.pageExportName} as default, metadata } from ${jsonString(route.pageImportPath)}`
    const shim = `/**
 * ${ADMIN_SHIM_MARKER} — do not edit.
 * Source: ${route.moduleId} admin.routes path=${route.path}
 */
export const dynamic = 'force-dynamic'

${exportLine}
`
    await writeFile(path.join(pageDir, 'page.tsx'), shim, 'utf8')
  }
}

type GeneratedRouteShim = {
  moduleId: string
  appDir: string
  fileName: 'page.tsx' | 'route.ts'
  importPath: string
  names: string[]
  dynamic?: string
  runtime?: string
  sourceLabel: string
}

type HostPageDecl = {
  moduleId: string
  id: string
  importPath: string
  exportName: string
}

type ImportExportDecl = {
  moduleId: string
  importPath: string
  exportName: string
}

function assertExportName(label: string, name: string): void {
  if (!ROUTE_EXPORT_NAME.test(name)) {
    throw new Error(`[modules:generate] Invalid export name on ${label}: ${name}`)
  }
}

function assertSegment(
  label: string,
  dynamic: string | undefined,
  runtime: string | undefined,
): void {
  if (dynamic && !ROUTE_DYNAMIC.has(dynamic)) {
    throw new Error(`[modules:generate] Invalid dynamic on ${label}: ${dynamic}`)
  }
  if (runtime && !ROUTE_RUNTIME.has(runtime)) {
    throw new Error(`[modules:generate] Invalid runtime on ${label}: ${runtime}`)
  }
}

function assertAppPath(label: string, routePath: string): string {
  const cleaned = routePath.trim().replace(/^\/+|\/+$/g, '')
  if (!cleaned || cleaned.includes('..') || cleaned.includes('\\') || path.isAbsolute(cleaned)) {
    throw new Error(`[modules:generate] Invalid route path on ${label}: ${routePath}`)
  }
  return cleaned
}

function collectGeneratedRouteShims(
  entries: StarforgeModuleManifest[],
): GeneratedRouteShim[] {
  const shims: GeneratedRouteShim[] = []
  for (const entry of entries) {
    for (const route of entry.publicRoutes ?? []) {
      const routePath = assertAppPath(`${entry.id} publicRoutes`, route.path ?? '')
      const pageImportPath = route.pageImportPath?.trim() ?? ''
      if (!pageImportPath) {
        throw new Error(`[modules:generate] publicRoutes on ${entry.id} needs pageImportPath`)
      }
      const root = route.root === 'frontend' ? 'frontend' : 'locale'
      const file = route.file === 'route' ? 'route' : 'page'
      const names: string[] = []
      if (file === 'page') {
        const exportName = route.pageExportName?.trim() || 'default'
        assertExportName(`${entry.id} ${routePath}`, exportName)
        names.push(exportName === 'default' ? 'default' : `${exportName} as default`)
      }
      for (const extra of route.reexport ?? []) {
        const name = extra.trim()
        assertExportName(`${entry.id} ${routePath}`, name)
        if (!names.includes(name)) names.push(name)
      }
      if (!names.length) {
        throw new Error(
          `[modules:generate] publicRoutes ${routePath} on ${entry.id} has no exports`,
        )
      }
      assertSegment(`${entry.id} ${routePath}`, route.dynamic, route.runtime)
      const base = root === 'frontend' ? FRONTEND_MODULES_DIR : PUBLIC_LOCALE_MODULES_DIR
      shims.push({
        moduleId: entry.id,
        appDir: path.join(base, ...routePath.split('/').filter(Boolean)),
        fileName: file === 'route' ? 'route.ts' : 'page.tsx',
        importPath: pageImportPath,
        names,
        dynamic: route.dynamic,
        runtime: route.runtime,
        sourceLabel: `publicRoutes path=${routePath}`,
      })
    }
    for (const route of entry.apiRoutes ?? []) {
      const routePath = assertAppPath(`${entry.id} apiRoutes`, route.path ?? '')
      const routeImportPath = route.routeImportPath?.trim() ?? ''
      const handlers = (route.handlers ?? []).map((name) => name.trim()).filter(Boolean)
      if (!routeImportPath || !handlers.length) {
        throw new Error(
          `[modules:generate] apiRoutes on ${entry.id} needs path, routeImportPath, and handlers`,
        )
      }
      for (const name of handlers) assertExportName(`${entry.id} ${routePath}`, name)
      assertSegment(`${entry.id} ${routePath}`, route.dynamic, route.runtime)
      shims.push({
        moduleId: entry.id,
        appDir: path.join(API_MODULES_DIR, ...routePath.split('/').filter(Boolean)),
        fileName: 'route.ts',
        importPath: routeImportPath,
        names: handlers,
        dynamic: route.dynamic,
        runtime: route.runtime,
        sourceLabel: `apiRoutes path=${routePath}`,
      })
    }
  }
  return shims
}

function collectHostPages(entries: StarforgeModuleManifest[]): HostPageDecl[] {
  const decls: HostPageDecl[] = []
  const seen = new Set<string>()
  for (const entry of entries) {
    for (const page of entry.hostPages ?? []) {
      const id = page.id?.trim() ?? ''
      const importPath = page.importPath?.trim() ?? ''
      const exportName = page.exportName?.trim() || 'default'
      if (!id || !importPath) {
        throw new Error(`[modules:generate] hostPages on ${entry.id} needs id + importPath`)
      }
      assertExportName(`${entry.id} hostPages ${id}`, exportName)
      if (seen.has(id)) {
        throw new Error(`[modules:generate] Duplicate hostPages id ${id}`)
      }
      seen.add(id)
      decls.push({ moduleId: entry.id, id, importPath, exportName })
    }
  }
  return decls
}

function collectModuleDoors(entries: StarforgeModuleManifest[]): HostPageDecl[] {
  const decls: HostPageDecl[] = []
  const seen = new Set<string>()
  for (const entry of entries) {
    for (const door of entry.doors ?? []) {
      const id = door.id?.trim() ?? ''
      const importPath = door.importPath?.trim() ?? ''
      if (!id || !importPath) {
        throw new Error(`[modules:generate] doors on ${entry.id} needs id + importPath`)
      }
      if (seen.has(id)) throw new Error(`[modules:generate] Duplicate doors id ${id}`)
      seen.add(id)
      decls.push({ moduleId: entry.id, id, importPath, exportName: 'default' })
    }
  }
  return decls
}

function moduleDoorLoaderLiterals(decls: HostPageDecl[]): string {
  return decls
    .map(
      (decl) => `  {
    id: ${jsonString(decl.id)},
    moduleId: ${jsonString(decl.moduleId)},
    load: async () => import(${jsonString(decl.importPath)}),
  }`,
    )
    .join(',\n')
}

function collectRealtimeChannelAcl(entries: StarforgeModuleManifest[]): ImportExportDecl[] {
  const decls: ImportExportDecl[] = []
  for (const entry of entries) {
    const acl = entry.realtimeChannelAcl
    if (!acl) continue
    const importPath = acl.importPath?.trim() ?? ''
    const exportName = acl.exportName?.trim() ?? ''
    if (!importPath || !exportName) {
      throw new Error(`[modules:generate] realtimeChannelAcl on ${entry.id} needs importPath + exportName`)
    }
    assertExportName(`${entry.id} realtimeChannelAcl`, exportName)
    decls.push({ moduleId: entry.id, importPath, exportName })
  }
  return decls
}

function collectLayoutFormCatalogs(entries: StarforgeModuleManifest[]): ImportExportDecl[] {
  const decls: ImportExportDecl[] = []
  for (const entry of entries) {
    const catalog = entry.layoutFormCatalog
    if (!catalog) continue
    const importPath = catalog.importPath?.trim() ?? ''
    const exportName = catalog.exportName?.trim() ?? ''
    if (!importPath || !exportName) {
      throw new Error(`[modules:generate] layoutFormCatalog on ${entry.id} needs importPath + exportName`)
    }
    assertExportName(`${entry.id} layoutFormCatalog`, exportName)
    decls.push({ moduleId: entry.id, importPath, exportName })
  }
  return decls
}

function collectStyleImports(entries: StarforgeModuleManifest[]): string[] {
  const specs: string[] = []
  for (const entry of entries) {
    for (const href of entry.styles ?? []) {
      const spec = href.trim()
      if (!spec.startsWith('@/') || spec.includes('..')) {
        throw new Error(`[modules:generate] Invalid styles import on ${entry.id}: ${href}`)
      }
      if (!specs.includes(spec)) specs.push(spec)
    }
  }
  return specs
}

function hostPageLoaderLiterals(decls: HostPageDecl[]): string {
  return decls
    .map((decl) => {
      const access = decl.exportName === 'default' ? 'default' : decl.exportName
      return `  {
    id: ${jsonString(decl.id)},
    moduleId: ${jsonString(decl.moduleId)},
    load: async () => (await import(${jsonString(decl.importPath)})).${access},
  }`
    })
    .join(',\n')
}

function realtimeAclLoaderLiterals(decls: ImportExportDecl[]): string {
  return decls
    .map(
      (decl) => `  {
    moduleId: ${jsonString(decl.moduleId)},
    load: async () => (await import(${jsonString(decl.importPath)})).${decl.exportName},
  }`,
    )
    .join(',\n')
}

function layoutCatalogLoaderLiterals(decls: ImportExportDecl[]): string {
  return decls
    .map(
      (decl) => `  {
    moduleId: ${jsonString(decl.moduleId)},
    load: async () => (await import(${jsonString(decl.importPath)})).${decl.exportName}(),
  }`,
    )
    .join(',\n')
}

function segmentConfigLines(shim: GeneratedRouteShim): string {
  const lines: string[] = []
  if (shim.dynamic) lines.push(`export const dynamic = ${jsonString(shim.dynamic)}`)
  if (shim.runtime) lines.push(`export const runtime = ${jsonString(shim.runtime)}`)
  return lines.length ? `${lines.join('\n')}\n\n` : ''
}

async function cleanGeneratedShims(dir: string): Promise<void> {
  let entries: string[]
  try {
    entries = await readdir(dir)
  } catch {
    return
  }
  for (const name of entries) {
    const full = path.join(dir, name)
    const st = await stat(full)
    if (st.isDirectory()) {
      await cleanGeneratedShims(full)
      continue
    }
    if (name !== 'page.tsx' && name !== 'route.ts') continue
    const src = await readFile(full, 'utf8')
    if (src.includes(ADMIN_SHIM_MARKER)) await rm(full)
  }
}

async function writeGeneratedRouteShims(shims: GeneratedRouteShim[]): Promise<void> {
  for (const dir of [PUBLIC_LOCALE_MODULES_DIR, FRONTEND_MODULES_DIR, API_MODULES_DIR]) {
    await mkdir(dir, { recursive: true })
    await cleanGeneratedShims(dir)
    const readme = `# Generated pack route shims

${ADMIN_SHIM_MARKER} — do not edit page.tsx or route.ts files here by hand.

Declare \`publicRoutes\` or \`apiRoutes\` on the module manifest. Route group
\`(modules)\` does not change the URL. A pack omitted from the allowlist does
not get a shim, so its URLs are not compiled.
`
    await writeFile(path.join(dir, 'README.md'), readme, 'utf8')
  }

  for (const shim of shims) {
    await mkdir(shim.appDir, { recursive: true })
    const body = `/**
 * ${ADMIN_SHIM_MARKER} — do not edit.
 * Source: ${shim.moduleId} ${shim.sourceLabel}
 */
${segmentConfigLines(shim)}export { ${shim.names.join(', ')} } from ${jsonString(shim.importPath)}
`
    await writeFile(path.join(shim.appDir, shim.fileName), body, 'utf8')
  }
}

async function writeModuleStyles(specs: string[]): Promise<void> {
  const imports = specs.map((spec) => `import ${jsonString(spec)}`).join('\n')
  const body = `/**
 * ${ADMIN_SHIM_MARKER} — do not edit.
 * Side-effect CSS for allowlisted packs. Layouts import this file
 * instead of a pack stylesheet path.
 */
${imports ? `${imports}\n` : 'export {}\n'}
`
  await mkdir(path.dirname(MODULE_STYLES_PATH), { recursive: true })
  await writeFile(MODULE_STYLES_PATH, body, 'utf8')
}

main().catch((error) => {
  console.error('[modules:generate] Failed:', error)
  process.exitCode = 1
})
