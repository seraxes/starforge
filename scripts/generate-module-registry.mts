export function isModuleAllowlisted(id: string): boolean {
  const key = id.trim()
  if (!key) return false
  if ((FIXED_REQUIRED_MODULE_IDS as readonly string[]).includes(key)) return true
  return ALLOWLISTED_MODULE_ID_SET.has(key)
}

