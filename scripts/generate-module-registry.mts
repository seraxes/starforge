/**
 * Write thin App Router re-export shims for each admin.routes path.
 * Lives under `admin/(modules)/…` so Core hand pages are not required for new packs.
 */
async function writeAdminRouteShims(
  routes: Array<{
    moduleId: string
    path: string
    pageImportPath: string
    pageExportName: string
  }>,
): Promise<void> {
  await mkdir(ADMIN_MODULES_DIR, { recursive: true })

  // Remove previously generated shim page.tsx files (marker comment).
  async function walkAndClean(dir: string): Promise<void> {
    let entries: string[]
    try {
      entries = await readdir(dir)
    } catch {
      return
    }
    for (const name of entries) {
      const full = path.join(dir, name)
      const st = await stat(full)
      if (st.isDirectory()) {
        await walkAndClean(full)
        continue
      }
      if (name !== 'page.tsx') continue
      const src = await readFile(full, 'utf8')
      if (src.includes(ADMIN_SHIM_MARKER)) {
        await rm(full)
      }
    }
  }
  await walkAndClean(ADMIN_MODULES_DIR)

  const readme = `# Generated admin module route shims

${ADMIN_SHIM_MARKER} — do not edit page.tsx files here by hand.

Declare \`admin.routes\` on the module manifest; \`npm run modules:generate\`
writes thin re-exports. Route group \`(modules)\` does not affect the URL
(\`media\` → \`/admin/media\`).
`
  await writeFile(path.join(ADMIN_MODULES_DIR, 'README.md'), readme, 'utf8')

  for (const route of routes) {
    const segments = route.path.split('/').filter(Boolean)
    if (!segments.length) continue
    const pageDir = path.join(ADMIN_MODULES_DIR, ...segments)
    await mkdir(pageDir, { recursive: true })
    const exportLine =
      route.pageExportName === 'default'
        ? `export { default, metadata } from ${jsonString(route.pageImportPath)}`
        : `export { ${route.pageExportName} as default, metadata } from ${jsonString(route.pageImportPath)}`
    const shim = `/**
 * ${ADMIN_SHIM_MARKER} — do not edit.
 * Source: ${route.moduleId} admin.routes path=${route.path}
 */
export const dynamic = 'force-dynamic'

${exportLine}
`
    await writeFile(path.join(pageDir, 'page.tsx'), shim, 'utf8')
  }
}

main().catch((error) => {
  console.error('[modules:generate] Failed:', error)
  process.exitCode = 1
})
