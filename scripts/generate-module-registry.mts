/**
 * Reads `starforge.modules.json` (or `SF_MODULES`) + module manifests and writes
 * `src/generated/module-registry.ts` — allowlist + client-safe particle editor/schema loaders.
 * `src/generated/module-registry.server.ts` — server-only dynamic import() loaders
 * (optional particles, atoms, publicShell, proxy hooks, settings panels, **module i18n messages**)
 * so client importers of the shared registry (ParticleEditorHost) do not pull
 * Payload/server graphs (SF-95 / SF-141 / i18n P3).
 *
 * Manifest source: `defineStarforgeModule` entries via `src/modules/manifest-index.ts`.
 *
 * Usage: npm run modules:generate
 */

import { mkdir, readFile, readdir, rm, stat, writeFile } from 'node:fs/promises'
import path from 'node:path'

import type { StarforgeModuleManifest } from '../src/core/modules/define-module.ts'
import { ALL_MODULE_MANIFESTS } from '../src/modules/manifest-index.ts'
import { closeModuleRequires } from '../src/core/modules/requires-graph.ts'
import {
  ROOT,
  resolveRequestedModuleIds,
  uniqSorted,
} from './lib/module-allowlist.mts'

const OUT_PATH = path.join(ROOT, 'src/generated/module-registry.ts')
const OUT_SERVER_PATH = path.join(ROOT, 'src/generated/module-registry.server.ts')
const MODULES_ROOT = path.join(ROOT, 'src/modules')
/** Generated App Router shims for `admin.routes` (M2). */
const ADMIN_MODULES_DIR = path.join(
  ROOT,
  'src/app/(frontend)/admin/(modules)',
)
const ADMIN_SHIM_MARKER = 'AUTO-GENERATED by `npm run modules:generate`'

type ModuleMessagePackDecl = {
  moduleId: string
  namespaces: string[]
  /** Import base e.g. `@/modules/consent/messages` */
  importBase: string
  /** Locale codes that have a JSON file on disk. */
  locales: string[]
}

/**
 * Resolve which `src/modules/<folder>` owns a manifest id.
 * Matches folder name, `product:`/`platform:`/`atom:` prefix strip, or importPath.
 */
function resolveModuleFolder(
  entry: StarforgeModuleManifest,
  folderNames: string[],
): string | null {
  const id = entry.id
  if (folderNames.includes(id)) return id
  for (const prefix of ['product:', 'platform:', 'atom:', 'hero:'] as const) {
    if (id.startsWith(prefix)) {
      const rest = id.slice(prefix.length)
      if (folderNames.includes(rest)) return rest
    }
  }
  const importPath = entry.importPath?.trim() ?? ''
  const m = importPath.match(/@\/modules\/([^/]+)/)
  if (m?.[1] && folderNames.includes(m[1])) return m[1]
  // publicShell / widget paths also hint the pack folder
  for (const shell of entry.publicShell ?? []) {
    const sm = shell.importPath?.match(/@\/modules\/([^/]+)/)
    if (sm?.[1] && folderNames.includes(sm[1])) return sm[1]
  }
  for (const widget of entry.admin?.dashboard ?? []) {
    const wm = widget.widgetImportPath?.match(/@\/modules\/([^/]+)/)
    if (wm?.[1] && folderNames.includes(wm[1])) return wm[1]
  }
  return null
}

async function listLocaleJsonFiles(messagesDir: string): Promise<string[]> {
  let names: string[]
  try {
    names = await readdir(messagesDir)
  } catch {
    return []
  }
  const locales: string[] = []
  for (const name of names) {
    if (!name.endsWith('.json')) continue
    const code = name.slice(0, -'.json'.length).trim()
    if (!code) continue
    locales.push(code)
  }
  return locales.sort((a, b) => a.localeCompare(b))
}

/**
 * Discover message packs for allowlisted modules (i18n P3).
 * Convention: `src/modules/<folder>/messages/<locale>.json`
 * plus optional manifest `i18n.namespaces` / `i18n.messagesDir`.
 */
async function discoverModuleMessagePacks(
  allowlistedEntries: StarforgeModuleManifest[],
): Promise<ModuleMessagePackDecl[]> {
  let folderNames: string[] = []
  try {
    const entries = await readdir(MODULES_ROOT, { withFileTypes: true })
    folderNames = entries.filter((e) => e.isDirectory()).map((e) => e.name)
  } catch {
    return []
  }

  const packs: ModuleMessagePackDecl[] = []
  for (const entry of allowlistedEntries) {
    const folder = resolveModuleFolder(entry, folderNames)
    if (!folder) {
      if (entry.i18n?.namespaces?.length) {
        console.warn(
          `[modules:generate] i18n declared on ${entry.id} but no src/modules/<folder> resolved — skip messages`,
        )
      }
      continue
    }
    const messagesDirName = entry.i18n?.messagesDir?.trim() || 'messages'
    const messagesAbs = path.join(MODULES_ROOT, folder, messagesDirName)
    const locales = await listLocaleJsonFiles(messagesAbs)
    const namespaces =
      entry.i18n?.namespaces?.map((n) => n.trim()).filter(Boolean) ??
      (locales.length ? [entry.id] : [])

    if (!namespaces.length) continue
    if (!locales.length) {
      // Declared namespaces but no packs yet (e.g. product:events stub) — skip loaders.
      console.log(
        `[modules:generate] i18n namespaces on ${entry.id} — no ${messagesDirName}/<locale>.json yet (ok)`,
      )
      continue
    }
    if (!locales.includes('en')) {
      console.warn(
        `[modules:generate] ${entry.id} messages missing en.json — skipping pack`,
      )
      continue
    }

    packs.push({
      moduleId: entry.id,
      namespaces,
      importBase: `@/modules/${folder}/${messagesDirName}`,
      locales,
    })
  }
  return packs.sort((a, b) => a.moduleId.localeCompare(b.moduleId))
}

function moduleMessageLoaderLiteral(pack: ModuleMessagePackDecl): string {
  const cases = pack.locales
    .filter((l) => l !== 'en')
    .map(
      (locale) =>
        `      case ${jsonString(locale)}:\n        return (await import(${jsonString(`${pack.importBase}/${locale}.json`)})).default`,
    )
    .join('\n')
  const switchBody = cases
    ? `${cases}\n      case 'en':\n      default:\n        return (await import(${jsonString(`${pack.importBase}/en.json`)})).default`
    : `      case 'en':\n      default:\n        return (await import(${jsonString(`${pack.importBase}/en.json`)})).default`
  return `  {
    moduleId: ${jsonString(pack.moduleId)},
    namespaces: ${jsonString(pack.namespaces)} as const,
    load: async (locale: string): Promise<Record<string, unknown>> => {
      switch (locale) {
${switchBody}
      }
    },
  }`
}

const FIXED_REQUIRED = ALL_MODULE_MANIFESTS.filter((e) => e.required).map((e) => e.id)

function jsonString(value: unknown): string {
  return JSON.stringify(value)
}

function isPlatformOrProduct(kind: StarforgeModuleManifest['kind']): boolean {
  return kind === 'platform' || kind === 'product'
}

function isParticleKind(kind: StarforgeModuleManifest['kind']): boolean {
  return kind === 'particle' || kind === 'particle-pack'
}

function catalogMetaLiteral(entry: StarforgeModuleManifest): string {
  const parts = [
    `id: ${jsonString(entry.id)}`,
    `kind: ${jsonString(entry.kind === 'particle-pack' ? 'particle' : entry.kind === 'hero' ? 'product' : entry.kind)}`,
    `label: ${jsonString(entry.label)}`,
    `description: ${jsonString(entry.description)}`,
    `required: ${entry.required === true}`,
    `defaultEnabled: ${entry.defaultEnabled !== false}`,
    `installed: true as const`,
  ]
  if (entry.featureFlag) parts.push(`featureFlag: ${jsonString(entry.featureFlag)}`)
  if (entry.navViews?.length) parts.push(`navViews: ${jsonString(entry.navViews)}`)
  return `{ ${parts.join(', ')} }`
}

function particleMetaLiteral(entry: StarforgeModuleManifest): string {
  const parts = [
    `id: ${jsonString(entry.id)}`,
    `name: ${jsonString(entry.label)}`,
    `description: ${jsonString(entry.description)}`,
    `required: ${entry.required === true}`,
    `defaultEnabled: ${entry.defaultEnabled !== false}`,
    `builtin: ${entry.builtin === true}`,
  ]
  if (entry.featureFlag) parts.push(`featureFlag: ${jsonString(entry.featureFlag)}`)
  if (entry.navViews?.length) parts.push(`navViews: ${jsonString(entry.navViews)}`)
  return `{ ${parts.join(', ')} }`
}

function atomMetaLiteral(entry: StarforgeModuleManifest): string {
  const type = entry.id.startsWith('atom:') ? entry.id.slice('atom:'.length) : entry.id
  return `{ type: ${jsonString(type)}, toggleId: ${jsonString(entry.id)}, label: ${jsonString(entry.label)}, description: ${jsonString(entry.description)}, defaultEnabled: ${entry.defaultEnabled !== false} }`
}

async function main(): Promise<void> {
  const resolved = await resolveRequestedModuleIds()
  const { flavor, requested, source } = resolved
  if (source === 'env') {
    console.log(`[modules:generate] Using SF_MODULES (${requested.length} ids)`)
  } else if (source === 'preset') {
    console.log(
      `[modules:generate] Using starforge.modules.json presets.${flavor} (${requested.length} ids)`,
    )
  } else {
    console.log(
      `[modules:generate] Using starforge.modules.json modules[] flavor=${flavor} (${requested.length} ids)`,
    )
  }

  const known = new Map(ALL_MODULE_MANIFESTS.map((e) => [e.id, e]))
  const unknown = requested.filter((id) => !known.has(id))
  if (unknown.length) {
    throw new Error(
      `[modules:generate] Unknown module ids in allowlist: ${unknown.join(', ')}`,
    )
  }

  const dupes = ALL_MODULE_MANIFESTS.map((e) => e.id).filter(
    (id, i, arr) => arr.indexOf(id) !== i,
  )
  if (dupes.length) {
    throw new Error(`[modules:generate] Duplicate manifest ids: ${[...new Set(dupes)].join(', ')}`)
  }

  const requestedIds = uniqSorted([...FIXED_REQUIRED, ...requested])
  const closed = closeModuleRequires(requestedIds, ALL_MODULE_MANIFESTS)
  if (closed.pulled.length) {
    console.log(`[modules:generate] pulled requires: ${closed.pulled.join(', ')}`)
  }
  const allowlisted = uniqSorted(closed.ids)

  const allowSet = new Set(allowlisted)
  const allowlistedEntries = ALL_MODULE_MANIFESTS.filter((e) => allowSet.has(e.id))

  const optionalParticles = allowlistedEntries.filter(
    (e) =>
      isParticleKind(e.kind) &&
      !e.builtin &&
      e.importPath &&
      e.exportName,
  )
  const optionalAtoms = allowlistedEntries.filter(
    (e) => e.kind === 'atom' && e.importPath && e.exportName,
  )
  const builtinParticles = allowlistedEntries.filter(
    (e) => isParticleKind(e.kind) && e.builtin,
  )
  const productPlatform = allowlistedEntries.filter((e) => isPlatformOrProduct(e.kind))

  const publicShellEntries: Array<{
    moduleId: string
    slot: string
    importPath: string
    exportName: string
  }> = []
  for (const entry of allowlistedEntries) {
    for (const shell of entry.publicShell ?? []) {
      if (!shell.importPath?.trim()) {
        console.warn(
          `[modules:generate] Skipping publicShell on ${entry.id} — missing importPath`,
        )
        continue
      }
      publicShellEntries.push({
        moduleId: entry.id,
        slot: shell.slot,
        importPath: shell.importPath.trim(),
        exportName: shell.exportName?.trim() || 'default',
      })
    }
  }

  const proxyHookEntries: Array<{
    moduleId: string
    order: number
    importPath: string
    exportName: string
  }> = []
  for (const entry of allowlistedEntries) {
    const hook = entry.proxy
    const importPath = hook?.handlerImportPath?.trim() ?? ''
    if (!importPath) continue
    const order = typeof hook?.order === 'number' && Number.isFinite(hook.order) ? hook.order : 100
    proxyHookEntries.push({
      moduleId: entry.id,
      order,
      importPath,
      exportName: hook?.handlerExportName?.trim() || 'default',
    })
  }
  proxyHookEntries.sort((a, b) => a.order - b.order || a.moduleId.localeCompare(b.moduleId))

  const moduleMessagePacks = await discoverModuleMessagePacks(allowlistedEntries)
  const moduleMessageLoaderLiterals = moduleMessagePacks
    .map(moduleMessageLoaderLiteral)
    .join(',\n')

  type ParticleHostDecl = {
    id: string
    configSchemaImportPath?: string
    configSchemaExportName?: string
    editorImportPath?: string
    editorExportName?: string
    defaultsImportPath?: string
    defaultsExportName?: string
  }

  const particleHostDecls: ParticleHostDecl[] = []
  for (const entry of allowlistedEntries) {
    if (isParticleKind(entry.kind)) {
      particleHostDecls.push({
        id: entry.id,
        configSchemaImportPath: entry.configSchemaImportPath,
        configSchemaExportName: entry.configSchemaExportName,
        editorImportPath: entry.editorImportPath,
        editorExportName: entry.editorExportName,
        defaultsImportPath: entry.defaultsImportPath,
        defaultsExportName: entry.defaultsExportName,
      })
    }
    for (const particle of entry.particles ?? []) {
      particleHostDecls.push({
        id: particle.id,
        configSchemaImportPath: particle.configSchemaImportPath,
        configSchemaExportName: particle.configSchemaExportName,
        editorImportPath: particle.editorImportPath,
        editorExportName: particle.editorExportName,
        defaultsImportPath: particle.defaultsImportPath,
        defaultsExportName: particle.defaultsExportName,
      })
    }
  }

  const schemaDecls = particleHostDecls.filter(
    (d) => d.configSchemaImportPath?.trim() && d.configSchemaExportName?.trim(),
  )
  const editorDecls = particleHostDecls.filter(
    (d) => d.editorImportPath?.trim() && d.editorExportName?.trim(),
  )
  const defaultsDecls = particleHostDecls.filter(
    (d) => d.defaultsImportPath?.trim() && d.defaultsExportName?.trim(),
  )

  const adminNavModules = allowlistedEntries.filter(
    (e) => e.admin?.nav && e.admin.nav.length > 0,
  )

  type AdminDashboardDecl = {
    moduleId: string
    id: string
    title: string
    order: number
    size: 'sm' | 'md' | 'lg'
    area?: string
    widgetImportPath: string
    widgetExportName: string
    statsImportPath?: string
    statsExportName?: string
  }
  const adminDashboardDecls: AdminDashboardDecl[] = []
  for (const entry of allowlistedEntries) {
    for (const widget of entry.admin?.dashboard ?? []) {
      const widgetId = widget.id?.trim() ?? ''
      const title = widget.title?.trim() ?? ''
      const widgetImportPath = widget.widgetImportPath?.trim() ?? ''
      if (!widgetId || !title || !widgetImportPath) {
        console.warn(
          `[modules:generate] Skipping admin.dashboard entry on ${entry.id} — need id + title + widgetImportPath`,
        )
        continue
      }
      const size = widget.size === 'sm' || widget.size === 'md' || widget.size === 'lg' ? widget.size : 'md'
      const decl: AdminDashboardDecl = {
        moduleId: entry.id,
        id: widgetId,
        title,
        order: widget.order ?? 100,
        size,
        widgetImportPath,
        widgetExportName: widget.widgetExportName?.trim() || 'default',
      }
      if (widget.area?.trim()) decl.area = widget.area.trim()
      const statsImportPath = widget.statsImportPath?.trim()
      if (statsImportPath) {
        decl.statsImportPath = statsImportPath
        decl.statsExportName = widget.statsExportName?.trim() || 'default'
      }
      adminDashboardDecls.push(decl)
    }
  }

  type AdminRouteDecl = {
    moduleId: string
    path: string
    pageImportPath: string
    pageExportName: string
  }
  const adminRouteDecls: AdminRouteDecl[] = []
  for (const entry of allowlistedEntries) {
    for (const route of entry.admin?.routes ?? []) {
      const routePath = route.path?.trim().replace(/^\/+|\/+$/g, '') ?? ''
      const pageImportPath = route.pageImportPath?.trim() ?? ''
      if (!routePath || !pageImportPath) {
        console.warn(
          `[modules:generate] Skipping admin.routes entry on ${entry.id} — need path + pageImportPath`,
        )
        continue
      }
      if (routePath.includes('..') || path.isAbsolute(routePath)) {
        throw new Error(
          `[modules:generate] Invalid admin.routes path on ${entry.id}: ${route.path}`,
        )
      }
      adminRouteDecls.push({
        moduleId: entry.id,
        path: routePath,
        pageImportPath,
        pageExportName: route.pageExportName?.trim() || 'default',
      })
    }
  }

  type SettingsPanelDecl = {
    moduleId: string
    topic: string
    panelImportPath: string
    panelExportName: string
  }
  const settingsPanelDecls: SettingsPanelDecl[] = []
  for (const entry of allowlistedEntries) {
    const settings = entry.settings
    if (!settings?.panelImportPath?.trim()) continue
    settingsPanelDecls.push({
      moduleId: entry.id,
      topic: settings.topic?.trim() || 'modules',
      panelImportPath: settings.panelImportPath.trim(),
      panelExportName: settings.panelExportName?.trim() || 'default',
    })
  }

  const particleLoaders = optionalParticles
    .map((e) => {
      return `  {
    id: ${jsonString(e.id)},
    load: async () => (await import(${jsonString(e.importPath!)})).${e.exportName!},
  }`
    })
    .join(',\n')

  const atomLoaders = optionalAtoms
    .map((e) => {
      const type = e.id.startsWith('atom:') ? e.id.slice('atom:'.length) : e.id
      return `  {
    type: ${jsonString(type)},
    toggleId: ${jsonString(e.id)},
    load: async () => (await import(${jsonString(e.importPath!)})).${e.exportName!},
  }`
    })
    .join(',\n')

  const publicShellLoaders = publicShellEntries
    .map((e) => {
      const loadExpr =
        e.exportName === 'default'
          ? `async () => (await import(${jsonString(e.importPath)})).default`
          : `async () => (await import(${jsonString(e.importPath)})).${e.exportName}`
      return `  {
    moduleId: ${jsonString(e.moduleId)},
    slot: ${jsonString(e.slot)},
    load: ${loadExpr},
  }`
    })
    .join(',\n')

  const proxyHookLoaders = proxyHookEntries
    .map((e) => {
      const loadExpr =
        e.exportName === 'default'
          ? `async () => (await import(${jsonString(e.importPath)})).default`
          : `async () => (await import(${jsonString(e.importPath)})).${e.exportName}`
      return `  {
    moduleId: ${jsonString(e.moduleId)},
    order: ${e.order},
    load: ${loadExpr},
  }`
    })
    .join(',\n')

  const schemaLoaders = schemaDecls
    .map(
      (d) => `  {
    id: ${jsonString(d.id)},
    load: async () => (await import(${jsonString(d.configSchemaImportPath!)})).${d.configSchemaExportName!},
  }`,
    )
    .join(',\n')

  const editorLoaders = editorDecls
    .map(
      (d) => `  {
    id: ${jsonString(d.id)},
    load: async () => (await import(${jsonString(d.editorImportPath!)})).${d.editorExportName!},
  }`,
    )
    .join(',\n')

  const defaultsLoaders = defaultsDecls
    .map(
      (d) => `  {
    id: ${jsonString(d.id)},
    load: async () => (await import(${jsonString(d.defaultsImportPath!)})).${d.defaultsExportName!}(),
  }`,
    )
    .join(',\n')

  const adminNavLiterals = adminNavModules
    .map((e) => {
      const group = e.admin?.navGroup
      const links = (e.admin?.nav ?? [])
        .map((link) => {
          const parts = [
            `label: ${jsonString(link.label)}`,
            `href: ${jsonString(link.href)}`,
            `order: ${link.order ?? 0}`,
          ]
          if (link.exact) parts.push(`exact: true`)
          if (link.area) parts.push(`area: ${jsonString(link.area)}`)
          if (link.group) parts.push(`group: ${jsonString(link.group)}`)
          return `{ ${parts.join(', ')} }`
        })
        .join(', ')
      const groupParts = [
        `moduleId: ${jsonString(e.id)}`,
        `id: ${jsonString(group?.id ?? e.id)}`,
        `label: ${jsonString(group?.label ?? e.label)}`,
        `order: ${group?.order ?? 100}`,
      ]
      if (group?.href) groupParts.push(`href: ${jsonString(group.href)}`)
      if (group?.expandable) groupParts.push(`expandable: true`)
      if (group?.defaultOpen) groupParts.push(`defaultOpen: true`)
      groupParts.push(`links: [${links}]`)
      return `  { ${groupParts.join(', ')} }`
    })
    .join(',\n')

  // Metadata only — server registry holds widget/stats dynamic import() loaders.
  const adminDashboardLiterals = adminDashboardDecls
    .slice()
    .sort((a, b) => a.order - b.order || a.id.localeCompare(b.id) || a.moduleId.localeCompare(b.moduleId))
    .map((d) => {
      const parts = [
        `moduleId: ${jsonString(d.moduleId)}`,
        `id: ${jsonString(d.id)}`,
        `title: ${jsonString(d.title)}`,
        `order: ${d.order}`,
        `size: ${jsonString(d.size)}`,
      ]
      if (d.area) parts.push(`area: ${jsonString(d.area)}`)
      parts.push(`widgetImportPath: ${jsonString(d.widgetImportPath)}`)
      parts.push(`widgetExportName: ${jsonString(d.widgetExportName)}`)
      if (d.statsImportPath) {
        parts.push(`statsImportPath: ${jsonString(d.statsImportPath)}`)
        parts.push(`statsExportName: ${jsonString(d.statsExportName)}`)
      }
      return `  { ${parts.join(', ')} }`
    })
    .join(',\n')

  const adminDashboardWidgetLoaderLiterals = adminDashboardDecls
    .map((d) => {
      const loadExpr =
        d.widgetExportName === 'default'
          ? `async () => (await import(${jsonString(d.widgetImportPath)})).default`
          : `async () => (await import(${jsonString(d.widgetImportPath)})).${d.widgetExportName}`
      return `  {
    moduleId: ${jsonString(d.moduleId)},
    id: ${jsonString(d.id)},
    load: ${loadExpr},
  }`
    })
    .join(',\n')

  const adminDashboardStatsLoaderLiterals = adminDashboardDecls
    .filter((d) => d.statsImportPath)
    .map((d) => {
      const exportName = d.statsExportName || 'default'
      const loadExpr =
        exportName === 'default'
          ? `async () => (await import(${jsonString(d.statsImportPath!)})).default`
          : `async () => (await import(${jsonString(d.statsImportPath!)})).${exportName}`
      return `  {
    moduleId: ${jsonString(d.moduleId)},
    id: ${jsonString(d.id)},
    load: ${loadExpr},
  }`
    })
    .join(',\n')

  // Metadata only — App Router shims under admin/(modules)/ do the page import.
  // Do NOT emit import() here: client code (particle-editor-host) imports this
  // registry, and Turbopack would pull server Media pages into the client graph.
  const adminRouteLoaderLiterals = adminRouteDecls
    .map((d) => {
      return `  {
    moduleId: ${jsonString(d.moduleId)},
    path: ${jsonString(d.path)},
    pageImportPath: ${jsonString(d.pageImportPath)},
    pageExportName: ${jsonString(d.pageExportName)},
  }`
    })
    .join(',\n')

  const settingsPanelLoaderLiterals = settingsPanelDecls
    .map((d) => {
      const loadExpr =
        d.panelExportName === 'default'
          ? `async () => (await import(${jsonString(d.panelImportPath)})).default`
          : `async () => (await import(${jsonString(d.panelImportPath)})).${d.panelExportName}`
      return `  {
    moduleId: ${jsonString(d.moduleId)},
    topic: ${jsonString(d.topic)},
    load: ${loadExpr},
  }`
    })
    .join(',\n')

  const productPlatformMeta = productPlatform.map(catalogMetaLiteral).join(',\n  ')
  const particleMeta = [...builtinParticles, ...optionalParticles]
    .map(particleMetaLiteral)
    .join(',\n  ')
  const optionalParticleMeta = optionalParticles.map(particleMetaLiteral).join(',\n  ')
  const atomMeta = optionalAtoms.map(atomMetaLiteral).join(',\n  ')
  const builtinParticleIds = builtinParticles.map((e) => e.id)
  const productPlatformIds = productPlatform.map((e) => e.id)
  const requiresMap: Record<string, string[]> = {}
  for (const entry of allowlistedEntries) {
    requiresMap[entry.id] = [...(entry.requires ?? [])]
  }

  // No Generated timestamp — CI diffs the file and a clock would always drift.
  const body = `/**
 * AUTO-GENERATED by \`npm run modules:generate\` — do not edit.
 * Source: starforge.modules.json (or SF_MODULES) + src/modules/manifest-index.ts
 * Flavor: ${flavor}
 *
 * Client-safe surface (allowlist + particle editor/schema/defaults).
 * Server-only dynamic import() loaders live in \`module-registry.server.ts\`.
 */

import type { ComponentType } from 'react'
import type { ZodType } from 'zod'

import type { ParticleEditorProps } from '@/core/modules/particles/editor-props'
import type { FeatureFlags } from '@/core/settings/defaults'
