/**
 * Reads `starforge.modules.json` (or `SF_MODULES`) + module manifests and writes
 * `src/generated/module-registry.ts` — allowlist + client-safe particle editor/schema loaders.
 * `src/generated/module-registry.server.ts` — server-only dynamic import() loaders
 * (optional particles, atoms, publicShell, settings panels) so client importers of the
 * shared registry (ParticleEditorHost) do not pull Payload/server graphs (SF-95 / SF-141).
 *
 * Manifest source: `defineStarforgeModule` entries via `src/modules/manifest-index.ts`.
 *
 * Usage: npm run modules:generate
 */

import { mkdir, readFile, readdir, rm, stat, writeFile } from 'node:fs/promises'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

import type { StarforgeModuleManifest } from '../src/core/modules/define-module.ts'
import { ALL_MODULE_MANIFESTS } from '../src/modules/manifest-index.ts'

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const ALLOWLIST_PATH = path.join(ROOT, 'starforge.modules.json')
const OUT_PATH = path.join(ROOT, 'src/generated/module-registry.ts')
const OUT_SERVER_PATH = path.join(ROOT, 'src/generated/module-registry.server.ts')
/** Generated App Router shims for `admin.routes` (M2). */
const ADMIN_MODULES_DIR = path.join(
  ROOT,
  'src/app/(frontend)/admin/(modules)',
)
const ADMIN_SHIM_MARKER = 'AUTO-GENERATED by `npm run modules:generate`'

type AllowlistFile = {
  flavor?: string
  modules?: unknown
}

const FIXED_REQUIRED = ALL_MODULE_MANIFESTS.filter((e) => e.required).map((e) => e.id)

function parseSfModulesEnv(raw: string | undefined): string[] | null {
  if (raw == null || !raw.trim()) return null
  return raw
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean)
}

function asIdList(raw: unknown): string[] {
  if (!Array.isArray(raw)) return []
  const out: string[] = []
  for (const row of raw) {
    if (typeof row === 'string' && row.trim()) out.push(row.trim())
  }
  return out
}

function uniqSorted(ids: string[]): string[] {
  return [...new Set(ids)].sort((a, b) => a.localeCompare(b))
}

function jsonString(value: unknown): string {
  return JSON.stringify(value)
}

function isPlatformOrProduct(kind: StarforgeModuleManifest['kind']): boolean {
  return kind === 'platform' || kind === 'product'
}

function isParticleKind(kind: StarforgeModuleManifest['kind']): boolean {
  return kind === 'particle' || kind === 'particle-pack'
}

function catalogMetaLiteral(entry: StarforgeModuleManifest): string {
  const parts = [
    `id: ${jsonString(entry.id)}`,
    `kind: ${jsonString(entry.kind === 'particle-pack' ? 'particle' : entry.kind === 'hero' ? 'product' : entry.kind)}`,
    `label: ${jsonString(entry.label)}`,
    `description: ${jsonString(entry.description)}`,
    `required: ${entry.required === true}`,
    `defaultEnabled: ${entry.defaultEnabled !== false}`,
    `installed: true as const`,
  ]
  if (entry.featureFlag) parts.push(`featureFlag: ${jsonString(entry.featureFlag)}`)
  if (entry.navViews?.length) parts.push(`navViews: ${jsonString(entry.navViews)}`)
  return `{ ${parts.join(', ')} }`
}

function particleMetaLiteral(entry: StarforgeModuleManifest): string {
  const parts = [
    `id: ${jsonString(entry.id)}`,
    `name: ${jsonString(entry.label)}`,
    `description: ${jsonString(entry.description)}`,
    `required: ${entry.required === true}`,
    `defaultEnabled: ${entry.defaultEnabled !== false}`,
    `builtin: ${entry.builtin === true}`,
  ]
  if (entry.featureFlag) parts.push(`featureFlag: ${jsonString(entry.featureFlag)}`)
  if (entry.navViews?.length) parts.push(`navViews: ${jsonString(entry.navViews)}`)
  return `{ ${parts.join(', ')} }`
}

function atomMetaLiteral(entry: StarforgeModuleManifest): string {
  const type = entry.id.startsWith('atom:') ? entry.id.slice('atom:'.length) : entry.id
  return `{ type: ${jsonString(type)}, toggleId: ${jsonString(entry.id)}, label: ${jsonString(entry.label)}, description: ${jsonString(entry.description)}, defaultEnabled: ${entry.defaultEnabled !== false} }`
}

async function main(): Promise<void> {
  const envList = parseSfModulesEnv(process.env.SF_MODULES)
  let flavor = 'core'
  let requested: string[]

  if (envList) {
    requested = envList
    console.log(`[modules:generate] Using SF_MODULES (${requested.length} ids)`)
  } else {
    const raw = await readFile(ALLOWLIST_PATH, 'utf8')
    const parsed = JSON.parse(raw) as AllowlistFile
    flavor = typeof parsed.flavor === 'string' && parsed.flavor.trim() ? parsed.flavor.trim() : 'core'
    requested = asIdList(parsed.modules)
    console.log(`[modules:generate] Using ${path.relative(ROOT, ALLOWLIST_PATH)} flavor=${flavor}`)
  }

  const known = new Map(ALL_MODULE_MANIFESTS.map((e) => [e.id, e]))
  const unknown = requested.filter((id) => !known.has(id))
  if (unknown.length) {
    console.warn(`[modules:generate] Ignoring unknown ids: ${unknown.join(', ')}`)
  }

  const dupes = ALL_MODULE_MANIFESTS.map((e) => e.id).filter(
    (id, i, arr) => arr.indexOf(id) !== i,
  )
  if (dupes.length) {
    throw new Error(`[modules:generate] Duplicate manifest ids: ${[...new Set(dupes)].join(', ')}`)
  }

  let allowlisted = uniqSorted([
    ...FIXED_REQUIRED,
    ...requested.filter((id) => known.has(id)),
  ])

  // Drop optional entries whose requires[] are not allowlisted.
  allowlisted = allowlisted.filter((id) => {
    const entry = known.get(id)
    if (!entry?.requires?.length) return true
    const missing = entry.requires.filter((req) => !allowlisted.includes(req))
    if (missing.length) {
      console.warn(
        `[modules:generate] Dropping ${id} — missing requires: ${missing.join(', ')}`,
      )
      return false
    }
    return true
  })

  // Re-add fixed required after filter.
  allowlisted = uniqSorted([...FIXED_REQUIRED, ...allowlisted])

  const allowSet = new Set(allowlisted)
  const allowlistedEntries = ALL_MODULE_MANIFESTS.filter((e) => allowSet.has(e.id))

  const optionalParticles = allowlistedEntries.filter(
    (e) =>
      isParticleKind(e.kind) &&
      !e.builtin &&
      e.importPath &&
      e.exportName,
  )
  const optionalAtoms = allowlistedEntries.filter(
    (e) => e.kind === 'atom' && e.importPath && e.exportName,
  )
  const builtinParticles = allowlistedEntries.filter(
    (e) => isParticleKind(e.kind) && e.builtin,
  )
  const productPlatform = allowlistedEntries.filter((e) => isPlatformOrProduct(e.kind))

  const publicShellEntries: Array<{
    moduleId: string
    slot: string
    importPath: string
    exportName: string
  }> = []
  for (const entry of allowlistedEntries) {
    for (const shell of entry.publicShell ?? []) {
      if (!shell.importPath?.trim()) {
        console.warn(
          `[modules:generate] Skipping publicShell on ${entry.id} — missing importPath`,
        )
        continue
      }
      publicShellEntries.push({
        moduleId: entry.id,
        slot: shell.slot,
        importPath: shell.importPath.trim(),
        exportName: shell.exportName?.trim() || 'default',
      })
    }
  }

  type ParticleHostDecl = {
    id: string
    configSchemaImportPath?: string
    configSchemaExportName?: string
    editorImportPath?: string
    editorExportName?: string
    defaultsImportPath?: string
    defaultsExportName?: string
  }

  const particleHostDecls: ParticleHostDecl[] = []
  for (const entry of allowlistedEntries) {
    if (isParticleKind(entry.kind)) {
      particleHostDecls.push({
        id: entry.id,
        configSchemaImportPath: entry.configSchemaImportPath,
        configSchemaExportName: entry.configSchemaExportName,
        editorImportPath: entry.editorImportPath,
        editorExportName: entry.editorExportName,
        defaultsImportPath: entry.defaultsImportPath,
        defaultsExportName: entry.defaultsExportName,
      })
    }
    for (const particle of entry.particles ?? []) {
      particleHostDecls.push({
        id: particle.id,
        configSchemaImportPath: particle.configSchemaImportPath,
        configSchemaExportName: particle.configSchemaExportName,
        editorImportPath: particle.editorImportPath,
        editorExportName: particle.editorExportName,
        defaultsImportPath: particle.defaultsImportPath,
        defaultsExportName: particle.defaultsExportName,
      })
    }
  }

  const schemaDecls = particleHostDecls.filter(
    (d) => d.configSchemaImportPath?.trim() && d.configSchemaExportName?.trim(),
  )
  const editorDecls = particleHostDecls.filter(
    (d) => d.editorImportPath?.trim() && d.editorExportName?.trim(),
  )
  const defaultsDecls = particleHostDecls.filter(
    (d) => d.defaultsImportPath?.trim() && d.defaultsExportName?.trim(),
  )

  const adminNavModules = allowlistedEntries.filter(
    (e) => e.admin?.nav && e.admin.nav.length > 0,
  )

  type AdminRouteDecl = {
    moduleId: string
    path: string
    pageImportPath: string
    pageExportName: string
  }
  const adminRouteDecls: AdminRouteDecl[] = []
  for (const entry of allowlistedEntries) {
    for (const route of entry.admin?.routes ?? []) {
      const routePath = route.path?.trim().replace(/^\/+|\/+$/g, '') ?? ''
      const pageImportPath = route.pageImportPath?.trim() ?? ''
      if (!routePath || !pageImportPath) {
        console.warn(
          `[modules:generate] Skipping admin.routes entry on ${entry.id} — need path + pageImportPath`,
        )
        continue
      }
      if (routePath.includes('..') || path.isAbsolute(routePath)) {
        throw new Error(
          `[modules:generate] Invalid admin.routes path on ${entry.id}: ${route.path}`,
        )
      }
      adminRouteDecls.push({
        moduleId: entry.id,
        path: routePath,
        pageImportPath,
        pageExportName: route.pageExportName?.trim() || 'default',
      })
    }
  }

  type SettingsPanelDecl = {
    moduleId: string
    topic: string
    panelImportPath: string
    panelExportName: string
  }
  const settingsPanelDecls: SettingsPanelDecl[] = []
  for (const entry of allowlistedEntries) {
    const settings = entry.settings
    if (!settings?.panelImportPath?.trim()) continue
    settingsPanelDecls.push({
      moduleId: entry.id,
      topic: settings.topic?.trim() || 'modules',
      panelImportPath: settings.panelImportPath.trim(),
      panelExportName: settings.panelExportName?.trim() || 'default',
    })
  }

  const particleLoaders = optionalParticles
    .map((e) => {
      return `  {
    id: ${jsonString(e.id)},
    load: async () => (await import(${jsonString(e.importPath!)})).${e.exportName!},
  }`
    })
    .join(',\n')

  const atomLoaders = optionalAtoms
    .map((e) => {
      const type = e.id.startsWith('atom:') ? e.id.slice('atom:'.length) : e.id
      return `  {
    type: ${jsonString(type)},
    toggleId: ${jsonString(e.id)},
    load: async () => (await import(${jsonString(e.importPath!)})).${e.exportName!},
  }`
    })
    .join(',\n')

  const publicShellLoaders = publicShellEntries
    .map((e) => {
      const loadExpr =
        e.exportName === 'default'
          ? `async () => (await import(${jsonString(e.importPath)})).default`
          : `async () => (await import(${jsonString(e.importPath)})).${e.exportName}`
      return `  {
    moduleId: ${jsonString(e.moduleId)},
    slot: ${jsonString(e.slot)},
    load: ${loadExpr},
  }`
    })
    .join(',\n')

  const schemaLoaders = schemaDecls
    .map(
      (d) => `  {
    id: ${jsonString(d.id)},
    load: async () => (await import(${jsonString(d.configSchemaImportPath!)})).${d.configSchemaExportName!},
  }`,
    )
    .join(',\n')

  const editorLoaders = editorDecls
    .map(
      (d) => `  {
    id: ${jsonString(d.id)},
    load: async () => (await import(${jsonString(d.editorImportPath!)})).${d.editorExportName!},
  }`,
    )
    .join(',\n')

  const defaultsLoaders = defaultsDecls
    .map(
      (d) => `  {
    id: ${jsonString(d.id)},
    load: async () => (await import(${jsonString(d.defaultsImportPath!)})).${d.defaultsExportName!}(),
  }`,
    )
    .join(',\n')

  const adminNavLiterals = adminNavModules
    .map((e) => {
      const group = e.admin?.navGroup
      const links = (e.admin?.nav ?? [])
        .map((link) => {
          const parts = [
            `label: ${jsonString(link.label)}`,
            `href: ${jsonString(link.href)}`,
            `order: ${link.order ?? 0}`,
          ]
          if (link.exact) parts.push(`exact: true`)
          if (link.area) parts.push(`area: ${jsonString(link.area)}`)
          if (link.group) parts.push(`group: ${jsonString(link.group)}`)
          return `{ ${parts.join(', ')} }`
        })
        .join(', ')
      const groupParts = [
        `moduleId: ${jsonString(e.id)}`,
        `id: ${jsonString(group?.id ?? e.id)}`,
        `label: ${jsonString(group?.label ?? e.label)}`,
        `order: ${group?.order ?? 100}`,
      ]
      if (group?.href) groupParts.push(`href: ${jsonString(group.href)}`)
      if (group?.expandable) groupParts.push(`expandable: true`)
      if (group?.defaultOpen) groupParts.push(`defaultOpen: true`)
      groupParts.push(`links: [${links}]`)
      return `  { ${groupParts.join(', ')} }`
    })
    .join(',\n')

  // Metadata only — App Router shims under admin/(modules)/ do the page import.
  // Do NOT emit import() here: client code (particle-editor-host) imports this
  // registry, and Turbopack would pull server Media pages into the client graph.
  const adminRouteLoaderLiterals = adminRouteDecls
    .map((d) => {
      return `  {
    moduleId: ${jsonString(d.moduleId)},
    path: ${jsonString(d.path)},
    pageImportPath: ${jsonString(d.pageImportPath)},
    pageExportName: ${jsonString(d.pageExportName)},
  }`
    })
    .join(',\n')

  const settingsPanelLoaderLiterals = settingsPanelDecls
    .map((d) => {
      const loadExpr =
        d.panelExportName === 'default'
          ? `async () => (await import(${jsonString(d.panelImportPath)})).default`
          : `async () => (await import(${jsonString(d.panelImportPath)})).${d.panelExportName}`
      return `  {
    moduleId: ${jsonString(d.moduleId)},
    topic: ${jsonString(d.topic)},
    load: ${loadExpr},
  }`
    })
    .join(',\n')

  const productPlatformMeta = productPlatform.map(catalogMetaLiteral).join(',\n  ')
  const particleMeta = [...builtinParticles, ...optionalParticles]
    .map(particleMetaLiteral)
    .join(',\n  ')
  const optionalParticleMeta = optionalParticles.map(particleMetaLiteral).join(',\n  ')
  const atomMeta = optionalAtoms.map(atomMetaLiteral).join(',\n  ')
  const builtinParticleIds = builtinParticles.map((e) => e.id)
  const productPlatformIds = productPlatform.map((e) => e.id)

  // No Generated timestamp — CI diffs the file and a clock would always drift.
  const body = `/**
 * AUTO-GENERATED by \`npm run modules:generate\` — do not edit.
 * Source: starforge.modules.json (or SF_MODULES) + src/modules/manifest-index.ts
 * Flavor: ${flavor}
 *
 * Client-safe surface (allowlist + particle editor/schema/defaults).
 * Server-only dynamic import() loaders live in \`module-registry.server.ts\`.
 */

import type { ComponentType } from 'react'
import type { ZodType } from 'zod'

import type { ParticleEditorProps } from '@/core/modules/particles/editor-props'
import type { FeatureFlags } from '@/core/settings/defaults'
import type { ModuleCatalogItem } from '@/core/settings/module-toggles'

export const MODULE_ALLOWLIST_FLAVOR = ${jsonString(flavor)} as const

/** Fixed required ids — always installed even if omitted from the allowlist file. */
export const FIXED_REQUIRED_MODULE_IDS = ${jsonString(FIXED_REQUIRED)} as const

/** Allowlisted module ids for this install/build (platform + product + particles + atoms). */
export const ALLOWLISTED_MODULE_IDS = ${jsonString(allowlisted)} as const

export type AllowlistedModuleId = (typeof ALLOWLISTED_MODULE_IDS)[number]

export const ALLOWLISTED_MODULE_ID_SET: ReadonlySet<string> = new Set(ALLOWLISTED_MODULE_IDS)

export function isModuleAllowlisted(id: string): boolean {
  const key = id.trim()
  if (!key) return false
  if ((FIXED_REQUIRED_MODULE_IDS as readonly string[]).includes(key)) return true
  return ALLOWLISTED_MODULE_ID_SET.has(key)
}

/** Builtin core particle ids included in this build (static register from particles/). */
export const ALLOWLISTED_BUILTIN_PARTICLE_IDS: readonly string[] = ${jsonString(builtinParticleIds)}

/** Platform + product catalog ids installed in this build. */
export const ALLOWLISTED_PRODUCT_PLATFORM_IDS: readonly string[] = ${jsonString(productPlatformIds)}

/**
 * Derived Site Settings → Modules rows for platform + product packs.
 * Replaces the hand-maintained PRODUCT_MODULE_CATALOG.
 */
export const ALLOWLISTED_PRODUCT_PLATFORM_META: ModuleCatalogItem[] = [
  ${productPlatformMeta || '// (none)'}
]

export type AllowlistedParticleMeta = {
  id: string
  name: string
  description: string
  required: boolean
  defaultEnabled: boolean
  builtin: boolean
  featureFlag?: keyof FeatureFlags
  navViews?: Array<{ key: string; label: string; href: string }>
}

/** Catalog rows for allowlisted particles (builtin + optional). */
export const ALLOWLISTED_PARTICLE_META: AllowlistedParticleMeta[] = [
  ${particleMeta || '// (none)'}
]

/** @deprecated Prefer ALLOWLISTED_PARTICLE_META filtered by !builtin — kept for older callers. */
export const ALLOWLISTED_OPTIONAL_PARTICLE_META: AllowlistedParticleMeta[] = [
  ${optionalParticleMeta || '// (none)'}
]

export type AllowlistedAtomMeta = {
  type: string
  toggleId: string
  label: string
  description: string
  defaultEnabled: boolean
}

export const ALLOWLISTED_ATOM_META: AllowlistedAtomMeta[] = [
  ${atomMeta || '// (none)'}
]

export type PublicShellSlot = 'head' | 'bodyStart' | 'bodyEnd'

export type ParticleConfigSchemaLoader = {
  id: string
  load: () => Promise<ZodType>
}

/** Zod schemas for particle slot config (M1 generic updateSlotConfigAction). */
export const particleConfigSchemaLoaders: ParticleConfigSchemaLoader[] = [
${schemaLoaders || '  // (none)'}
]

export type ParticleEditorLoader = {
  id: string
  // Editors accept ParticleEditorProps; concrete components may tighten fields.
  load: () => Promise<ComponentType<ParticleEditorProps> | ComponentType<Record<string, unknown>>>
}

/** Client cog editors loaded by ParticleEditorHost (M1). */
export const particleEditorLoaders: ParticleEditorLoader[] = [
${editorLoaders || '  // (none)'}
]

export type ParticleDefaultsLoader = {
  id: string
  load: () => Promise<Record<string, unknown>>
}

/** Defaults for new slots (M1). */
export const particleDefaultsLoaders: ParticleDefaultsLoader[] = [
${defaultsLoaders || '  // (none)'}
]

export type AdminNavContributionLink = {
  label: string
  href: string
  order: number
  exact?: boolean
  area?: string
  group?: string
}

export type AdminNavContribution = {
  moduleId: string
  id: string
  label: string
  order: number
  href?: string
  expandable?: boolean
  defaultOpen?: boolean
  links: AdminNavContributionLink[]
}

/** Admin left-nav groups contributed by allowlisted module manifests (M2). */
export const adminNavContributions: AdminNavContribution[] = [
${adminNavLiterals || '  // (none)'}
]

export type AdminRouteLoader = {
  moduleId: string
  /** Path under /admin/ (no leading slash), e.g. media/settings. */
  path: string
  /** Module page import path — loaded by generated App Router shims, not here. */
  pageImportPath: string
  pageExportName: string
}

/**
 * Admin App Router pages from allowlisted manifests (M2).
 * Runtime loads via \`admin/(modules)/…\` shims — no import() in this client-shared file.
 */
export const adminRouteLoaders: AdminRouteLoader[] = [
${adminRouteLoaderLiterals || '  // (none)'}
]
`

  const serverBody = `/**
 * AUTO-GENERATED by \`npm run modules:generate\` — do not edit.
 * Source: starforge.modules.json (or SF_MODULES) + src/modules/manifest-index.ts
 * Flavor: ${flavor}
 *
 * Server-only dynamic import() loaders. Client code must import from
 * \`module-registry.ts\` only — never this file.
 */
import 'server-only'

import type { ComponentType, ReactNode } from 'react'

import type { StarforgeModule } from '@/core/modules/types'
import type { StarforgeAtomDefinition } from '@/core/page-settings/types'
import type { PublicShellSlot } from '@/generated/module-registry'

export type { PublicShellSlot }

export type OptionalParticleLoader = {
  id: string
  load: () => Promise<StarforgeModule>
}

/**
 * Dynamic import boundaries for optional / extension particles.
 * Packs absent from the allowlist are omitted here — not eager-imported.
 */
export const optionalParticleLoaders: OptionalParticleLoader[] = [
${particleLoaders || '  // (none allowlisted)'}
]

export type OptionalAtomLoader = {
  type: string
  toggleId: string
  load: () => Promise<StarforgeAtomDefinition>
}

export const optionalAtomLoaders: OptionalAtomLoader[] = [
${atomLoaders || '  // (none allowlisted)'}
]

export type PublicShellLoader = {
  moduleId: string
  slot: PublicShellSlot
  load: () => Promise<ComponentType<Record<string, never>> | ((...args: never[]) => ReactNode)>
}

/** Public layout shell contributions from allowlisted module manifests. */
export const publicShellLoaders: PublicShellLoader[] = [
${publicShellLoaders || '  // (none allowlisted)'}
]

export type ModuleSettingsPanelLoader = {
  moduleId: string
  topic: string
  load: () => Promise<ComponentType<Record<string, unknown>>>
}

/** Site Settings topic panels from allowlisted manifests (M2 sf_module_settings host). */
export const moduleSettingsPanelLoaders: ModuleSettingsPanelLoader[] = [
${settingsPanelLoaderLiterals || '  // (none)'}
]

export async function loadAllowlistedOptionalParticles(): Promise<StarforgeModule[]> {
  return Promise.all(optionalParticleLoaders.map((entry) => entry.load()))
}

export async function loadAllowlistedAtoms(): Promise<StarforgeAtomDefinition[]> {
  return Promise.all(optionalAtomLoaders.map((entry) => entry.load()))
}

export async function loadPublicShellSlot(
  slot: PublicShellSlot,
): Promise<Array<{ moduleId: string; Component: ComponentType<Record<string, never>> }>> {
  const matched = publicShellLoaders.filter((entry) => entry.slot === slot)
  const loaded = await Promise.all(
    matched.map(async (entry) => ({
      moduleId: entry.moduleId,
      Component: (await entry.load()) as ComponentType<Record<string, never>>,
    })),
  )
  return loaded
}
`

  await mkdir(path.dirname(OUT_PATH), { recursive: true })
  await writeFile(OUT_PATH, body, 'utf8')
  await writeFile(OUT_SERVER_PATH, serverBody, 'utf8')

  await writeAdminRouteShims(adminRouteDecls)

  console.log(
    `[modules:generate] Wrote ${path.relative(ROOT, OUT_PATH)} + ${path.relative(ROOT, OUT_SERVER_PATH)} (${allowlisted.length} ids, ${optionalParticles.length} optional particles, ${optionalAtoms.length} atoms, ${publicShellEntries.length} publicShell, ${schemaDecls.length} schemas, ${editorDecls.length} editors, ${adminNavModules.length} adminNav, ${adminRouteDecls.length} adminRoutes, ${settingsPanelDecls.length} settingsPanels)`,
  )
}

/**
 * Write thin App Router re-export shims for each admin.routes path.
 * Lives under `admin/(modules)/…` so Core hand pages are not required for new packs.
 */
async function writeAdminRouteShims(
  routes: Array<{
    moduleId: string
    path: string
    pageImportPath: string
    pageExportName: string
  }>,
): Promise<void> {
  await mkdir(ADMIN_MODULES_DIR, { recursive: true })

  // Remove previously generated shim page.tsx files (marker comment).
  async function walkAndClean(dir: string): Promise<void> {
    let entries: string[]
    try {
      entries = await readdir(dir)
    } catch {
      return
    }
    for (const name of entries) {
      const full = path.join(dir, name)
      const st = await stat(full)
      if (st.isDirectory()) {
        await walkAndClean(full)
        continue
      }
      if (name !== 'page.tsx') continue
      const src = await readFile(full, 'utf8')
      if (src.includes(ADMIN_SHIM_MARKER)) {
        await rm(full)
      }
    }
  }
  await walkAndClean(ADMIN_MODULES_DIR)

  const readme = `# Generated admin module route shims

${ADMIN_SHIM_MARKER} — do not edit page.tsx files here by hand.

Declare \`admin.routes\` on the module manifest; \`npm run modules:generate\`
writes thin re-exports. Route group \`(modules)\` does not affect the URL
(\`media\` → \`/admin/media\`).
`
  await writeFile(path.join(ADMIN_MODULES_DIR, 'README.md'), readme, 'utf8')

  for (const route of routes) {
    const segments = route.path.split('/').filter(Boolean)
    if (!segments.length) continue
    const pageDir = path.join(ADMIN_MODULES_DIR, ...segments)
    await mkdir(pageDir, { recursive: true })
    const exportLine =
      route.pageExportName === 'default'
        ? `export { default, metadata } from ${jsonString(route.pageImportPath)}`
        : `export { ${route.pageExportName} as default, metadata } from ${jsonString(route.pageImportPath)}`
    const shim = `/**
 * ${ADMIN_SHIM_MARKER} — do not edit.
 * Source: ${route.moduleId} admin.routes path=${route.path}
 */
export const dynamic = 'force-dynamic'

${exportLine}
`
    await writeFile(path.join(pageDir, 'page.tsx'), shim, 'utf8')
  }
}

main().catch((error) => {
  console.error('[modules:generate] Failed:', error)
  process.exitCode = 1
})
