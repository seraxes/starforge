{
  "name": "starforge",
  "version": "0.1.0",
  "private": true,
  "description": "Starforge — reusable product core with Payload CMS as the content/media module",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "db:core:push": "drizzle-kit push",
    "db:core:studio": "drizzle-kit studio",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed.ts",
    "verify:cms-sso": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/verify-cms-sso.mts",
    "verify:admin-no-login-form": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/verify-admin-no-login-form.mts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@uiw/react-codemirror": "^4.25.12",
    "better-auth": "^1.7.14",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.44.5",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "3.92.1",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.34.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "drizzle-kit": "0.31.4",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.5",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}
