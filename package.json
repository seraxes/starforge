{
  "name": "starforge",
  "version": "0.1.0",
  "private": true,
  "description": "Lean reusable website core toolkit — auth, users, profiles, email",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @starforge/api",
    "dev:web": "npm run dev -w @starforge/web",
    "build": "npm run build -w @starforge/shared && npm run build -w @starforge/api && npm run build -w @starforge/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w @starforge/api",
    "db:migrate": "npm run db:migrate -w @starforge/api",
    "db:studio": "npm run db:studio -w @starforge/api"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
